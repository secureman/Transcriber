# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.env

# Transcription server's own runtime data (DB, caches, logs) — this must
# never be committed. A stray committed transcriptions.db here previously
# caused re-transcription of already-done chapters whenever the server's
# data-dir resolution fell back to this folder — see paths.py.
transcription_server/*.db
transcription_server/vtt_cache/
transcription_server/tmp_audio/
transcription_server/logs/
