# ── Server ────────────────────────────────────────────────────────────────
# Where your Audiobookshelf server lives and its API token (Settings →
# Users → API Key in Audiobookshelf).
ABS_BASE_URL=http://192.168.1.10:13378
ABS_API_TOKEN=

# Groq API key for Whisper transcription (https://console.groq.com/keys).
GROQ_API_KEY=

# ── Storage (optional) ────────────────────────────────────────────────────
# Defaults are repo-local on a PC and ~/.local/share/audiobook-transcriber
# inside Termux — you normally do NOT need to change these. Override only
# if you want the data somewhere else (paths may use ~).
# OUTPUT_DIR=/path/to/vtt_cache
# TEMP_DIR=/path/to/tmp_audio
# DB_PATH=/path/to/transcriptions.db
# LOG_DIR=/path/to/logs

# ── Binaries (optional) ───────────────────────────────────────────────────
# Auto-discovered from PATH / Termux prefix. Override only if needed.
# FFMPEG_PATH=/path/to/ffmpeg
# FFPROBE_PATH=/path/to/ffprobe

# ── Runtime ───────────────────────────────────────────────────────────────
# How many chapters to transcribe in parallel (keep 1–2 on a phone).
MAX_CONCURRENT_JOBS=2
# Parallel Groq API calls across all jobs (Groq is I/O-bound; raise on
# paid tiers with higher rate limits).
MAX_CONCURRENT_GROQ=4
# Parallel chunk uploads within a single chapter.
MAX_CONCURRENT_CHUNKS=4
# Target chunk size in MB fed to Groq per request (must stay < 25 MB).
# Smaller chunks parallelize better; ~10 MB ≈ 20 min of 64 kbps audio.
GROQ_CHUNK_SIZE_MB=10.0
# Whisper model: whisper-large-v3-turbo is ~8x faster with a small
# accuracy tradeoff; use whisper-large-v3 for maximum quality.
GROQ_MODEL=whisper-large-v3-turbo
HOST=0.0.0.0
PORT=8000