<?xml version="1.0" encoding="utf-8"?>
<!--
    Allow cleartext HTTP for self-hosted ABS + transcription server running
    on the LAN. The <domain> element only matches exact hostnames — it does
    NOT work as a CIDR subnet mask — so the old per-subnet entries never
    covered any real device IPs. ExoPlayer (just_audio) is subject to
    Android's NSP while Dart/Dio is not, which is why REST calls worked but
    audio loading was silently blocked.

    For a LAN-only self-hosted setup this is safe. If you ever expose the
    servers to the internet, replace this with a <domain-config> scoped to
    your specific host and use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
